{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuru-list",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/e/*", "/healthz"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kuru-list",
      "database_id": "712aaacd-9e94-4943-94ce-70f79b359eb7",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "92072601",
      "simple": {
        "limit": 12,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
}
